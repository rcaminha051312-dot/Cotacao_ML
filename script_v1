import pandas as pd
import pyautogui as pa
import webbrowser as wb
from urllib.parse import quote

def main():
    cotacao_oficina=r'C:\Users\Escudo Compras\Desktop\Compras\Orçamento oficina.xlsx'
    df = pd.read_excel(cotacao_oficina, header=3)
    lista_produtos=ler_produtos(df)
    for i, produto in enumerate(lista_produtos):
        if not produto:
            continue
        termo_pesquisa= str(quote(produto.replace(' ','-')))
        url=f"https://lista.mercadolivre.com.br/{termo_pesquisa}"+"_CustoFrete_Gratis_OrderId_PRICE_NoIndex_True"
        
        print(f"Pesquisando {produto}\n")
        wb.open(url, new=0, autoraise=True)
        print("Encontrando o menor preço\n")
        menor_preco=melhor_preco(termo_pesquisa)
        print(f"O menor preço encontrado foi de {menor_preco}\n")
        df.loc[i, '$ Un.']=float(menor_preco)
    df.to_excel('cotação_pronta.xlsx', index=False)    


def ler_produtos(df):
    df['produto'] = (df['Peça'].fillna('').astype(str).str.strip() + ' ' + df['Moto'].fillna('').astype(str).str.strip()).str.strip()
    lista_produtos=df['produto'].tolist()
    return lista_produtos

def melhor_preco(termo_pesquisa):
    while True:
        pa.hotkey('alt', 'tab')
        preco=input("Qual o menor preço que você encontrou?\n")
        pa.hotkey('alt', 'tab')
        pa.sleep(1)
        range='PriceRange_0-' + str(preco)
        url=f"https://lista.mercadolivre.com.br/{termo_pesquisa}_CustoFrete_Gratis_OrderId_PRICE_{range}_NoIndex_True"
        pa.hotkey('ctrl', 'l')
        pa.sleep(0.5)
        pa.typewrite(url)
        pa.sleep(0.5)
        pa.press('enter')
        pa.sleep(0.5)
        continuar=input("Você encontrou um preço melhor? 1-S/0-N\n")
        if continuar.strip().upper() not in ('S', '1'):
            return preco
if __name__ == "__main__":
    main()
