import pyautogui

def main():
    cord_max=None
    while True:
        maximo=r"D:\Projetos prog\python\ml cotacao\pngs\maximo.png"
        preco=input("Qual o menor preço que você encontrou?\n")
        pyautogui.hotkey('alt','tab')
        pyautogui.sleep(0.5)
        pyautogui.hotkey('ctrl','home')
        pyautogui.sleep(0.5)
        pyautogui.hotkey('ctrl','f')
        pyautogui.sleep(0.5)
        pyautogui.typewrite("Preco")
        pyautogui.sleep(0.5)
        pyautogui.hotkey('ctrl','f')
        pyautogui.sleep(0.5)
        pyautogui.hotkey('ctrl','a')
        pyautogui.sleep(0.5)
        pyautogui.typewrite("Maximo")
        pyautogui.sleep(0.5)
        try:
            cord_max=pyautogui.locateCenterOnScreen(maximo, confidence=0.75)
        except pyautogui.ImageNotFoundException:
            print("Botão Máximo não encontrado, posicione o mouse acima do botão e aguarde\n")
            print("Registrando em:\n3")
            pyautogui.sleep(1)
            print("2")
            pyautogui.sleep(1)
            print("1")
            pyautogui.sleep(1)
            cord_max=pyautogui.position()
        pyautogui.click(cord_max)
        pyautogui.typewrite(preco)
        pyautogui.press('enter')
        pyautogui.hotkey('alt','tab')
        continuar=input("Você encontrou um preço melhor? 1-S/0-N\n")
        if continuar.strip().upper() not in ('S', '1'):
            cord_max=None
            break
if __name__ == "__main__":
    main()